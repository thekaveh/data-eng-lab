# Copy this file to atlas.env.user (which is ignored) and replace every
# placeholder with an independently generated high-entropy value. Do not reuse
# the MinIO root, Spark, Iceberg, Jupyter, or Zeppelin credentials.
MINIO_RETENTION_ACCESS_KEY=CHANGE_ME_ACCESS
MINIO_RETENTION_SECRET_KEY=CHANGE_ME_RETENTION_SECRET
CHECKPOINT_RETENTION_LEASE_TOKEN=CHANGE_ME_LEASE_TOKEN
CHECKPOINT_RETENTION_OPERATOR_TOKEN=CHANGE_ME_OPERATOR_TOKEN

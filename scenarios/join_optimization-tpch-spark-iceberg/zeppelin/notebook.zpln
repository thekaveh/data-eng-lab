    },
    {
      "title": "2. Setup",
      "text": "%md\n## 2. Setup",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "2. Setup (code)",
      "text": "%spark\nimport spark.implicits._\nimport org.apache.spark.sql.functions._\n// spark pre-bound (Spark Connect + lakehouse catalog)\nimport java.net.{HttpURLConnection, URL}\nimport java.nio.charset.StandardCharsets\nimport com.fasterxml.jackson.databind.ObjectMapper\nimport scala.collection.JavaConverters._\n\nval datasetScaleOverride = Option(z.input(\"dataset_scale\", \"\")).filter(_.nonEmpty)\nval datasetScale = datasetScaleOverride.orElse(Option(System.getenv(\"DATASET_SCALE\"))).getOrElse(\"small\")\nrequire(Set(\"tiny\", \"small\", \"medium\").contains(datasetScale), \"invalid DATASET_SCALE\")\nval resolverUri = Option(System.getenv(\"DATASET_RESOLVER_URI\")).getOrElse(throw new IllegalArgumentException(\"DATASET_RESOLVER_URI is required\"))\nval resolverConnection = new URL(resolverUri.stripSuffix(\"/\") + \"/v1/resolve\").openConnection().asInstanceOf[HttpURLConnection]\nresolverConnection.setRequestMethod(\"POST\")\nresolverConnection.setRequestProperty(\"Content-Type\", \"application/json\")\nresolverConnection.setDoOutput(true)\nval resolverRequest = \"{\\\"dataset\\\":\\\"tpch\\\",\\\"expected_scale\\\":\\\"\" + datasetScale + \"\\\"}\"\nresolverConnection.getOutputStream.write(resolverRequest.getBytes(StandardCharsets.UTF_8))\nrequire(resolverConnection.getResponseCode == 200, \"dataset resolution failed\")\nval datasetResolution = new ObjectMapper().readTree(resolverConnection.getInputStream)\nresolverConnection.disconnect()\nrequire(datasetResolution.get(\"dataset\").asText == \"tpch\" && datasetResolution.get(\"scale\").asText == datasetScale)\nval planId = datasetResolution.get(\"plan_id\").asText\nval publicationId = datasetResolution.get(\"publication_id\").asText\nval manifestSha256 = datasetResolution.get(\"manifest_sha256\").asText\nrequire(planId.matches(\"[0-9a-f]{64}\") && publicationId.matches(\"[0-9a-f]{32}\") && manifestSha256.matches(\"[0-9a-f]{64}\"))\nval datasetObjects = datasetResolution.get(\"objects\").elements.asScala.toVector\nval datasetObjectFields = Set(\"object_name\", \"uri\", \"size_bytes\", \"sha256\", \"schema_id\")\nrequire(datasetObjects.forall { item =>\n  item.fieldNames.asScala.toSet == datasetObjectFields &&\n  item.get(\"size_bytes\").isIntegralNumber && item.get(\"size_bytes\").asLong >= 0 &&\n  item.get(\"sha256\").asText.matches(\"[0-9a-f]{64}\") && item.get(\"schema_id\").asText.nonEmpty\n})\nval datasetObjectNames = datasetObjects.map(_.get(\"object_name\").asText)\nval expectedNamesByScale = Map(\n  \"tiny\" -> Vector(\"customer.parquet\", \"lineitem.parquet\", \"nation.parquet\", \"orders.parquet\", \"part.parquet\", \"partsupp.parquet\", \"region.parquet\", \"supplier.parquet\"),\n  \"small\" -> Vector(\"customer.parquet\", \"lineitem.parquet\", \"nation.parquet\", \"orders.parquet\", \"part.parquet\", \"partsupp.parquet\", \"region.parquet\", \"supplier.parquet\"),\n  \"medium\" -> Vector(\"customer.parquet\", \"lineitem.parquet\", \"nation.parquet\", \"orders.parquet\", \"part.parquet\", \"partsupp.parquet\", \"region.parquet\", \"supplier.parquet\")\n)\nrequire(datasetObjectNames == expectedNamesByScale(datasetScale) && datasetObjectNames.distinct.size == datasetObjectNames.size)\nval datasetUris = datasetObjects.map(_.get(\"uri\").asText)\nval generationPrefix = s\"s3://landing/tpch/_generations/$planId/$publicationId/\"\nrequire(datasetUris.zip(datasetObjectNames).forall { case (uri, name) => uri == generationPrefix + name })\nval datasetObjectByName = datasetObjectNames.zip(datasetUris).toMap",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "3. Read",
      "text": "%md\n## 3. Read",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "3. Read (code)",
      "text": "%spark\nval orders = spark.read.parquet(datasetObjectByName(\"orders.parquet\"))\nval customer = spark.read.parquet(datasetObjectByName(\"customer.parquet\"))",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "4. Transform",
      "text": "%md\n## 4. Transform",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "4. Transform (code)",
      "text": "%spark\nval joined = orders.join(broadcast(customer), $\"o_custkey\" === $\"c_custkey\")\njoined.explain()\nval mart = joined.groupBy($\"c_mktsegment\").agg(sum($\"o_totalprice\").as(\"revenue\"), count(\"*\").as(\"orders\"))",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "5. Write",
      "text": "%md\n## 5. Write",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "5. Write (code)",
      "text": "%spark\nmart.writeTo(\"lakehouse.gold.tpch_segment_revenue\").using(\"iceberg\").createOrReplace()",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "6. Verify",
      "text": "%md\n## 6. Verify",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "6. Verify (code)",
      "text": "%spark\nprintln(\"AQE: \" + spark.conf.get(\"spark.sql.adaptive.enabled\"))\nspark.table(\"lakehouse.gold.tpch_segment_revenue\").orderBy($\"revenue\".desc).show(false)",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    }
  ],
  "name": "join_optimization-tpch-spark-iceberg",

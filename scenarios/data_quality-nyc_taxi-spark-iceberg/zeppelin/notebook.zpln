{
  "paragraphs": [
    {
      "title": "1. Overview",
      "text": "%md\n## 1. Overview\n\n> **Production warning:** These educational cells directly replace the production Silver tables without production provenance, bypass Airflow serialization, and do not persist governed quality facts. They can invalidate production monitoring. Production writes must use the `nyc_taxi_data_quality` DAG and reviewed Spark application.",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "2. Setup",
      "text": "%md\n## 2. Setup",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "2. Setup (code)",
      "text": "%spark\nimport spark.implicits._\nimport org.apache.spark.sql.functions._",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "3. Read",
      "text": "%md\n## 3. Read",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "3. Read (code)",
      "text": "%spark\nval columns = Seq(\n  \"VendorID\", \"tpep_pickup_datetime\", \"tpep_dropoff_datetime\",\n  \"passenger_count\", \"trip_distance\", \"RatecodeID\", \"store_and_fwd_flag\",\n  \"PULocationID\", \"DOLocationID\", \"payment_type\", \"fare_amount\", \"extra\",\n  \"mta_tax\", \"tip_amount\", \"tolls_amount\", \"improvement_surcharge\",\n  \"total_amount\", \"congestion_surcharge\", \"airport_fee\", \"trip_date\"\n)\nval df = spark.table(\"lakehouse.bronze.nyc_taxi_trips\").select(columns.map(col): _*)",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "4. Transform",
      "text": "%md\n## 4. Transform",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "4. Transform (code)",
      "text": "%spark\nval rule = \"fare_amount > 0 AND passenger_count BETWEEN 1 AND 6\"\nval isValid = coalesce(expr(rule), lit(false))\nval valid = df.where(isValid)\nval quarantine = df.where(not(isValid))\nval source_count = df.count()\nval valid_count = valid.count()\nval quarantine_count = quarantine.count()\nassert(valid_count + quarantine_count == source_count)",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "5. Write",
      "text": "%md\n## 5. Write",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "5. Write (code)",
      "text": "%spark\nvalid.writeTo(\"lakehouse.silver.nyc_taxi_clean\").using(\"iceberg\").createOrReplace()\nquarantine.writeTo(\"lakehouse.silver.nyc_taxi_quarantine\").using(\"iceberg\").createOrReplace()",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "6. Verify",
      "text": "%md\n## 6. Verify",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "6. Verify (code)",
      "text": "%spark\nval counts = spark.sql(\"SELECT (SELECT count(*) FROM lakehouse.silver.nyc_taxi_clean) AS clean, (SELECT count(*) FROM lakehouse.silver.nyc_taxi_quarantine) AS quarantined\").first()\nassert(counts.getLong(0) + counts.getLong(1) == source_count)\nprintln(s\"source=$source_count clean=${counts.getLong(0)} quarantined=${counts.getLong(1)}\")",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    }
  ],

    {
      "title": "3. Read",
      "text": "%md\n## 3. Read",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "3. Read (code)",
      "text": "%spark\nval taxiPaths = Seq(\n  \"s3a://landing/nyc_taxi/yellow_tripdata_2023-01.parquet\",\n  \"s3a://landing/nyc_taxi/yellow_tripdata_2023-02.parquet\",\n  \"s3a://landing/nyc_taxi/yellow_tripdata_2023-03.parquet\",\n  \"s3a://landing/nyc_taxi/yellow_tripdata_2023-04.parquet\",\n  \"s3a://landing/nyc_taxi/yellow_tripdata_2023-05.parquet\",\n  \"s3a://landing/nyc_taxi/yellow_tripdata_2023-06.parquet\"\n)\nval raw = taxiPaths\n  .map(path => spark.read.parquet(path).withColumn(\"passenger_count\", col(\"passenger_count\").cast(\"double\")))\n  .reduce(_.unionByName(_))\nraw.printSchema()",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "4. Transform",
      "text": "%md\n## 4. Transform",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "4. Transform (code)",
      "text": "%spark\nval bronze = raw\n  .where($\"tpep_pickup_datetime\".isNotNull && ($\"passenger_count\" > 0))\n  .withColumn(\"trip_date\", to_date($\"tpep_pickup_datetime\"))",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "5. Write",
      "text": "%md\n## 5. Write",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "5. Write (code)",
      "text": "%spark\nbronze.writeTo(\"lakehouse.bronze.nyc_taxi_trips\").using(\"iceberg\").createOrReplace()",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "6. Verify",
      "text": "%md\n## 6. Verify",
      "config": {},

    },
    {
      "title": "2. Setup",
      "text": "%md\n## 2. Setup",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "2. Setup (code)",
      "text": "%spark\nimport spark.implicits._\nimport org.apache.spark.sql.functions._\n// spark is pre-bound by the Atlas Zeppelin interpreter (Spark Connect + lakehouse catalog)\nimport java.net.{HttpURLConnection, URL}\nimport java.nio.charset.StandardCharsets\nimport com.fasterxml.jackson.databind.ObjectMapper\nimport scala.collection.JavaConverters._\n\nval datasetScaleOverride = Option(z.input(\"dataset_scale\", \"\")).filter(_.nonEmpty)\nval datasetScale = datasetScaleOverride.orElse(Option(System.getenv(\"DATASET_SCALE\"))).getOrElse(\"small\")\nrequire(Set(\"tiny\", \"small\", \"medium\").contains(datasetScale), \"invalid DATASET_SCALE\")\nval resolverUri = Option(System.getenv(\"DATASET_RESOLVER_URI\")).getOrElse(throw new IllegalArgumentException(\"DATASET_RESOLVER_URI is required\"))\nval resolverConnection = new URL(resolverUri.stripSuffix(\"/\") + \"/v1/resolve\").openConnection().asInstanceOf[HttpURLConnection]\nresolverConnection.setRequestMethod(\"POST\")\nresolverConnection.setRequestProperty(\"Content-Type\", \"application/json\")\nresolverConnection.setDoOutput(true)\nval resolverRequest = \"{\\\"dataset\\\":\\\"nyc_taxi\\\",\\\"expected_scale\\\":\\\"\" + datasetScale + \"\\\"}\"\nresolverConnection.getOutputStream.write(resolverRequest.getBytes(StandardCharsets.UTF_8))\nrequire(resolverConnection.getResponseCode == 200, \"dataset resolution failed\")\nval datasetResolution = new ObjectMapper().readTree(resolverConnection.getInputStream)\nresolverConnection.disconnect()\nrequire(datasetResolution.get(\"dataset\").asText == \"nyc_taxi\" && datasetResolution.get(\"scale\").asText == datasetScale)\nval planId = datasetResolution.get(\"plan_id\").asText\nval publicationId = datasetResolution.get(\"publication_id\").asText\nval manifestSha256 = datasetResolution.get(\"manifest_sha256\").asText\nrequire(planId.matches(\"[0-9a-f]{64}\") && publicationId.matches(\"[0-9a-f]{32}\") && manifestSha256.matches(\"[0-9a-f]{64}\"))\nval datasetObjects = datasetResolution.get(\"objects\").elements.asScala.toVector\nval datasetObjectFields = Set(\"object_name\", \"uri\", \"size_bytes\", \"sha256\", \"schema_id\")\nrequire(datasetObjects.forall { item =>\n  item.fieldNames.asScala.toSet == datasetObjectFields &&\n  item.get(\"size_bytes\").isIntegralNumber && item.get(\"size_bytes\").asLong >= 0 &&\n  item.get(\"sha256\").asText.matches(\"[0-9a-f]{64}\") && item.get(\"schema_id\").asText.nonEmpty\n})\nval datasetObjectNames = datasetObjects.map(_.get(\"object_name\").asText)\nval expectedNamesByScale = Map(\n  \"tiny\" -> Vector(\"yellow_tripdata_2023-01.parquet\"),\n  \"small\" -> Vector(\"yellow_tripdata_2023-01.parquet\", \"yellow_tripdata_2023-02.parquet\", \"yellow_tripdata_2023-03.parquet\"),\n  \"medium\" -> Vector(\"yellow_tripdata_2023-01.parquet\", \"yellow_tripdata_2023-02.parquet\", \"yellow_tripdata_2023-03.parquet\", \"yellow_tripdata_2023-04.parquet\", \"yellow_tripdata_2023-05.parquet\", \"yellow_tripdata_2023-06.parquet\")\n)\nrequire(datasetObjectNames == expectedNamesByScale(datasetScale) && datasetObjectNames.distinct.size == datasetObjectNames.size)\nval datasetUris = datasetObjects.map(_.get(\"uri\").asText)\nval generationPrefix = s\"s3://landing/nyc_taxi/_generations/$planId/$publicationId/\"\nrequire(datasetUris.zip(datasetObjectNames).forall { case (uri, name) => uri == generationPrefix + name })\nval datasetObjectByName = datasetObjectNames.zip(datasetUris).toMap",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "3. Read",
      "text": "%md\n## 3. Read",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "3. Read (code)",
      "text": "%spark\nval taxiPaths = datasetUris\nval raw = taxiPaths\n  .map(path => spark.read.parquet(path).withColumn(\"passenger_count\", col(\"passenger_count\").cast(\"double\")))\n  .reduce(_.unionByName(_))\nraw.printSchema()",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "4. Transform",
      "text": "%md\n## 4. Transform",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "4. Transform (code)",
      "text": "%spark\nval bronze = raw\n  .where($\"tpep_pickup_datetime\".isNotNull && ($\"passenger_count\" > 0))\n  .withColumn(\"trip_date\", to_date($\"tpep_pickup_datetime\"))",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "5. Write",
      "text": "%md\n## 5. Write",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "5. Write (code)",
      "text": "%spark\nbronze.writeTo(\"lakehouse.bronze.nyc_taxi_trips\").using(\"iceberg\").createOrReplace()",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "6. Verify",
      "text": "%md\n## 6. Verify",

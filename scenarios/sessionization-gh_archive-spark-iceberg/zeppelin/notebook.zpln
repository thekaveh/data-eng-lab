      }
    },
    {
      "title": "2. Setup",
      "text": "%md\n## 2. Setup",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "2. Setup (code)",
      "text": "%spark\nimport spark.implicits._\nimport org.apache.spark.sql.functions._\nimport org.apache.spark.sql.expressions.Window\nimport java.net.{HttpURLConnection, URL}\nimport java.nio.charset.StandardCharsets\nimport com.fasterxml.jackson.core.JsonParser\nimport com.fasterxml.jackson.databind.{JsonNode, ObjectMapper}\nimport scala.collection.JavaConverters._\n\nval datasetScaleOverride = Option(z.input(\"dataset_scale\", null))\nval datasetScale = datasetScaleOverride.orElse(Option(System.getenv(\"DATASET_SCALE\"))).getOrElse(\"small\")\nrequire(Set(\"tiny\", \"small\", \"medium\").contains(datasetScale), \"invalid DATASET_SCALE\")\nval resolverUri = Option(System.getenv(\"DATASET_RESOLVER_URI\")).getOrElse(throw new IllegalArgumentException(\"DATASET_RESOLVER_URI is required\"))\nval resolverConnection = new URL(resolverUri.stripSuffix(\"/\") + \"/v1/resolve\").openConnection().asInstanceOf[HttpURLConnection]\nresolverConnection.setRequestMethod(\"POST\")\nresolverConnection.setRequestProperty(\"Content-Type\", \"application/json\")\nresolverConnection.setDoOutput(true)\nresolverConnection.setConnectTimeout(30000)\nresolverConnection.setReadTimeout(30000)\nval resolverRequest = \"{\\\"dataset\\\":\\\"gh_archive\\\",\\\"expected_scale\\\":\\\"\" + datasetScale + \"\\\"}\"\nval resolverOutput = resolverConnection.getOutputStream\nresolverOutput.write(resolverRequest.getBytes(StandardCharsets.UTF_8))\nresolverOutput.close()\nrequire(resolverConnection.getResponseCode == 200, \"dataset resolution failed\")\nval resolutionBytes = resolverConnection.getInputStream.readNBytes((1 << 20) + 1)\nrequire(resolutionBytes.length <= (1 << 20), \"dataset resolution failed\")\nval mapper = new ObjectMapper().enable(JsonParser.Feature.STRICT_DUPLICATE_DETECTION)\nval datasetResolution = mapper.readTree(resolutionBytes)\ndef jsonDepth(node: JsonNode): Int =\n  if (node.isContainerNode) 1 + node.elements.asScala.map(jsonDepth).foldLeft(0)(math.max) else 0\nrequire(jsonDepth(datasetResolution) <= 16, \"dataset resolution failed\")\nresolverConnection.disconnect()\nval datasetResolutionFields = Set(\"dataset\", \"scale\", \"plan_id\", \"manifest_sha256\", \"publication_id\", \"objects\")\nrequire(datasetResolution.fieldNames.asScala.toSet == datasetResolutionFields)\nrequire(\n  datasetResolution.get(\"dataset\").isTextual && datasetResolution.get(\"scale\").isTextual &&\n  datasetResolution.get(\"plan_id\").isTextual && datasetResolution.get(\"publication_id\").isTextual &&\n  datasetResolution.get(\"manifest_sha256\").isTextual,\n  \"dataset resolution failed\"\n)\nrequire(datasetResolution.get(\"dataset\").asText == \"gh_archive\" && datasetResolution.get(\"scale\").asText == datasetScale)\nval planId = datasetResolution.get(\"plan_id\").asText\nval publicationId = datasetResolution.get(\"publication_id\").asText\nval manifestSha256 = datasetResolution.get(\"manifest_sha256\").asText\nrequire(planId.matches(\"[0-9a-f]{64}\") && publicationId.matches(\"[0-9a-f]{32}\") && manifestSha256.matches(\"[0-9a-f]{64}\"))\nval objectsNode = datasetResolution.get(\"objects\")\nrequire(objectsNode.isArray && objectsNode.size > 0, \"dataset resolution failed\")\nval datasetObjects = objectsNode.elements.asScala.toVector\nval datasetObjectFields = Set(\"object_name\", \"uri\", \"size_bytes\", \"sha256\", \"schema_id\")\nrequire(datasetObjects.forall { item =>\n  item.fieldNames.asScala.toSet == datasetObjectFields &&\n  item.get(\"object_name\").isTextual && item.get(\"object_name\").asText.matches(\"[A-Za-z0-9._-]+\") &&\n  !Set(\".\", \"..\").contains(item.get(\"object_name\").asText) && item.get(\"uri\").isTextual &&\n  item.get(\"size_bytes\").isIntegralNumber && item.get(\"size_bytes\").asLong >= 0 &&\n  item.get(\"sha256\").isTextual && item.get(\"sha256\").asText.matches(\"[0-9a-f]{64}\") && item.get(\"schema_id\").isTextual && item.get(\"schema_id\").asText.nonEmpty\n})\nval datasetObjectNames = datasetObjects.map(_.get(\"object_name\").asText)\nval expectedNamesByScale = Map(\n  \"tiny\" -> Vector(\"2023-01-01-0.json.gz\"),\n  \"small\" -> Vector(\"2023-01-01-0.json.gz\", \"2023-01-01-1.json.gz\", \"2023-01-01-2.json.gz\"),\n  \"medium\" -> Vector(\"2023-01-01-0.json.gz\", \"2023-01-01-1.json.gz\", \"2023-01-01-2.json.gz\", \"2023-01-01-3.json.gz\", \"2023-01-01-4.json.gz\", \"2023-01-01-5.json.gz\")\n)\nrequire(datasetObjectNames == expectedNamesByScale(datasetScale) && datasetObjectNames.distinct.size == datasetObjectNames.size)\nval datasetUris = datasetObjects.map(_.get(\"uri\").asText)\nval generationPrefix = s\"s3://landing/gh_archive/_generations/$planId/$publicationId/\"\nrequire(datasetUris.zip(datasetObjectNames).forall { case (uri, name) => uri == generationPrefix + name })\nval datasetSparkUris = datasetUris.map(uri => \"s3a://\" + uri.stripPrefix(\"s3://\"))\nval datasetObjectByName = datasetObjectNames.zip(datasetSparkUris).toMap",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "3. Read",
      "text": "%md\n## 3. Read",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "3. Read (code)",
      "text": "%spark\nval raw = spark.read.json(datasetSparkUris: _*)\nval events = raw.select($\"actor.login\".as(\"actor_login\"), $\"created_at\".cast(\"timestamp\").as(\"ts\"))",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "4. Transform",
      "text": "%md\n## 4. Transform",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "4. Transform (code)",
      "text": "%spark\nval w = Window.partitionBy($\"actor_login\").orderBy($\"ts\")\nval gaps = events.withColumn(\"prev_ts\", lag($\"ts\", 1).over(w)).withColumn(\"new_session\", when($\"prev_ts\".isNull || (unix_timestamp($\"ts\") - unix_timestamp($\"prev_ts\")) > 1800, 1).otherwise(0))\nval sessions = gaps.withColumn(\"session_id\", sum($\"new_session\").over(w))",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "5. Write",
      "text": "%md\n## 5. Write",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "5. Write (code)",
      "text": "%spark\nsessions.writeTo(\"lakehouse.silver.gh_sessions\").using(\"iceberg\").createOrReplace()",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "6. Verify",
      "text": "%md\n## 6. Verify",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "6. Verify (code)",
      "text": "%spark\nspark.sql(\"SELECT actor_login, count(distinct session_id) AS sessions FROM lakehouse.silver.gh_sessions GROUP BY actor_login ORDER BY sessions DESC\").show(false)",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    }
  ],
  "name": "sessionization-gh_archive-spark-iceberg",

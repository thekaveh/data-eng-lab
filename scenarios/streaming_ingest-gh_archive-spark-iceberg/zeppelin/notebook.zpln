    {
      "title": "2. Setup",
      "text": "%md\n## 2. Setup",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "2. Setup (code)",
      "text": "%spark\nimport spark.implicits._\nimport org.apache.spark.sql.functions._\nimport org.apache.spark.sql.types._\n// spark is pre-bound by the Atlas Zeppelin interpreter\nimport java.net.{HttpURLConnection, URL}\nimport java.nio.charset.StandardCharsets\nimport com.fasterxml.jackson.databind.ObjectMapper\nimport scala.collection.JavaConverters._\n\nval datasetScaleOverride = Option(z.input(\"dataset_scale\", \"\")).filter(_.nonEmpty)\nval datasetScale = datasetScaleOverride.orElse(Option(System.getenv(\"DATASET_SCALE\"))).getOrElse(\"small\")\nrequire(Set(\"tiny\", \"small\", \"medium\").contains(datasetScale), \"invalid DATASET_SCALE\")\nval resolverUri = Option(System.getenv(\"DATASET_RESOLVER_URI\")).getOrElse(throw new IllegalArgumentException(\"DATASET_RESOLVER_URI is required\"))\nval resolverConnection = new URL(resolverUri.stripSuffix(\"/\") + \"/v1/resolve\").openConnection().asInstanceOf[HttpURLConnection]\nresolverConnection.setRequestMethod(\"POST\")\nresolverConnection.setRequestProperty(\"Content-Type\", \"application/json\")\nresolverConnection.setDoOutput(true)\nval resolverRequest = \"{\\\"dataset\\\":\\\"gh_archive\\\",\\\"expected_scale\\\":\\\"\" + datasetScale + \"\\\"}\"\nresolverConnection.getOutputStream.write(resolverRequest.getBytes(StandardCharsets.UTF_8))\nrequire(resolverConnection.getResponseCode == 200, \"dataset resolution failed\")\nval datasetResolution = new ObjectMapper().readTree(resolverConnection.getInputStream)\nresolverConnection.disconnect()\nrequire(datasetResolution.get(\"dataset\").asText == \"gh_archive\" && datasetResolution.get(\"scale\").asText == datasetScale)\nval planId = datasetResolution.get(\"plan_id\").asText\nval publicationId = datasetResolution.get(\"publication_id\").asText\nval manifestSha256 = datasetResolution.get(\"manifest_sha256\").asText\nrequire(planId.matches(\"[0-9a-f]{64}\") && publicationId.matches(\"[0-9a-f]{32}\") && manifestSha256.matches(\"[0-9a-f]{64}\"))\nval datasetObjects = datasetResolution.get(\"objects\").elements.asScala.toVector\nval datasetObjectFields = Set(\"object_name\", \"uri\", \"size_bytes\", \"sha256\", \"schema_id\")\nrequire(datasetObjects.forall { item =>\n  item.fieldNames.asScala.toSet == datasetObjectFields &&\n  item.get(\"size_bytes\").isIntegralNumber && item.get(\"size_bytes\").asLong >= 0 &&\n  item.get(\"sha256\").asText.matches(\"[0-9a-f]{64}\") && item.get(\"schema_id\").asText.nonEmpty\n})\nval datasetObjectNames = datasetObjects.map(_.get(\"object_name\").asText)\nval expectedNamesByScale = Map(\n  \"tiny\" -> Vector(\"2023-01-01-0.json.gz\"),\n  \"small\" -> Vector(\"2023-01-01-0.json.gz\", \"2023-01-01-1.json.gz\", \"2023-01-01-2.json.gz\"),\n  \"medium\" -> Vector(\"2023-01-01-0.json.gz\", \"2023-01-01-1.json.gz\", \"2023-01-01-2.json.gz\", \"2023-01-01-3.json.gz\", \"2023-01-01-4.json.gz\", \"2023-01-01-5.json.gz\")\n)\nrequire(datasetObjectNames == expectedNamesByScale(datasetScale) && datasetObjectNames.distinct.size == datasetObjectNames.size)\nval datasetUris = datasetObjects.map(_.get(\"uri\").asText)\nval generationPrefix = s\"s3://landing/gh_archive/_generations/$planId/$publicationId/\"\nrequire(datasetUris.zip(datasetObjectNames).forall { case (uri, name) => uri == generationPrefix + name })\nval datasetObjectByName = datasetObjectNames.zip(datasetUris).toMap",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "3. Read",
      "text": "%md\n## 3. Read",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "3. Read (code)",
      "text": "%spark\nval schema = new StructType().add(\"id\", StringType).add(\"type\", StringType).add(\"created_at\", StringType)\nval streams = datasetUris.map(uri => spark.readStream.schema(schema).json(uri))\nval stream = streams.reduce(_.unionByName(_))",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "4. Transform",
      "text": "%md\n## 4. Transform",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "4. Transform (code)",
      "text": "%spark\nval events = stream.withColumn(\"created_at\", $\"created_at\".cast(\"timestamp\"))",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "5. Write",
      "text": "%md\n## 5. Write",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "5. Write (code)",
      "text": "%spark\nval query = events.writeStream.format(\"iceberg\").outputMode(\"append\").option(\"checkpointLocation\", \"s3a://checkpoints/gh_events_file\").toTable(\"lakehouse.bronze.gh_events_stream\")\n// query.awaitTermination() to keep stream running",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "6. Verify",
      "text": "%md\n## 6. Verify",
      "config": {},

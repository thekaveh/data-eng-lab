    {
      "title": "3. Read (code)",
      "text": "%spark\nval schema = new StructType().add(\"id\", StringType).add(\"type\", StringType).add(\"created_at\", StringType)\nval streams = datasetSparkUris.map(uri => spark.readStream.schema(schema).json(uri))\nval stream = streams.reduce(_.unionByName(_))",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "4. Transform",
      "text": "%md\n## 4. Transform",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "4. Transform (code)",
      "text": "%spark\nval events = stream.withColumn(\"created_at\", $\"created_at\".cast(\"timestamp\"))",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "5. Write",
      "text": "%md\n## 5. Write",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
    {
      "title": "5. Write (code)",
      "text": "%spark\nval lease = new CheckpointLease(\n  checkpointId = \"streaming-gh-archive-file-v1\",\n  prefix = s\"gh_events_file/$datasetScale/$publicationId/$manifestSha256/\",\n  workload = \"streaming_ingest-gh_archive-spark-iceberg\",\n  terminalState = \"completed\",\n  generation = Map(\"scale\" -> datasetScale, \"publication_id\" -> publicationId, \"manifest_sha256\" -> manifestSha256)\n)\nvar leasePrimary: Throwable = null\ntry {\n  val query = events.writeStream.format(\"iceberg\").outputMode(\"append\").option(\"checkpointLocation\", s\"s3a://checkpoints/gh_events_file/$datasetScale/$publicationId/$manifestSha256\").toTable(\"lakehouse.bronze.gh_events_stream\")\n  lease.bindQuery(query)\n  query.awaitTermination()\n} catch {\n  case error: Throwable =>\n    leasePrimary = error\n    throw error\n} finally {\n  try lease.close()\n  catch {\n    case _: Throwable if leasePrimary != null =>\n      leasePrimary.addSuppressed(new IllegalStateException(\"checkpoint lease cleanup failed\"))\n    case cleanup: Throwable => throw cleanup\n  }\n}",
      "config": {},
      "settings": {
        "params": {},
        "forms": {}
      }
    },
